interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
state:
  api_key: "{{api_key}}"
  steam_ids:
{{#each steam_ids as |steam_id|}}
    - "{{steam_id}}"
{{/each}}
redact:
  fields:
    - api_key
program: |-
  // GetOwnedGames takes a single steamid rather than a batch, and has no
  // pagination of any kind, so every poll is a complete snapshot of each
  // account's library. The configured steam_ids list is walked one ID per
  // evaluation: state.player_offset is the index of the ID being requested, and
  // is reset to 0 on the last ID and on error so the next poll starts a fresh
  // walk from the top of the list. This mirrors the walk in the
  // recently_played stream. One document is emitted per owned game rather than
  // per account, so a poll publishes a few hundred documents per account
  // instead of a handful, which is why the default interval is coarse.
  int(state.?player_offset.orValue(0)).as(offset,
    // front(tail(...)) rather than steam_ids[offset] so an offset left behind
    // by a shortened list cannot index out of range. string() is deliberate: a
    // SteamID64 that reached state as a number rather than a string fails here
    // instead of being silently rounded to a different account.
    front(tail(state.steam_ids, offset), 1).map(id, string(id)).join(",").as(steam_id,
      state.with(
        request(
          "GET",
          state.url.trim_right("/") + "/IPlayerService/GetOwnedGames/v1/?" + {
            "key": [state.api_key],
            "steamid": [steam_id],
            // include_appinfo is what makes name and img_icon_url appear at
            // all, and without include_played_free_games the free to play
            // titles the account actually plays are left out of the library
            // entirely. Both flags matter.
            "include_appinfo": ["true"],
            "include_played_free_games": ["true"],
          }.format_query()
        ).do_request().as(resp,
          // Neither a private profile nor an account that owns nothing is an
          // error: both arrive as a plain 200. A private or unreadable profile
          // answers with {"response":{}} and no games key at all. An account
          // that is readable but owns nothing is handled defensively for both
          // that same empty response object and an empty games array, because
          // which of the two the live API returns for that case has never been
          // verified. Nothing below may assume the key is present.
          // The failure branch never decodes the body: an invalid key returns
          // 403 and a malformed steamid 400, both with an HTML body.
          (resp.StatusCode == 200) ?
            resp.Body.decode_json().as(body,
              {
                // The response carries no steamid anywhere, but steam.player.id
                // is a required time series dimension, so the account that was
                // asked about is injected into each game here, under the same
                // key GetPlayerSummaries returns it as. Without it every
                // document would be rejected at index time.
                "events": (size(body.?response.games.orValue([])) != 0) ?
                  dyn(
                    body.response.games.map(g,
                      {
                        "message": g.with({"steamid": steam_id}).as(game,
                          // rtime_last_played is 0 for a game that has never
                          // been launched: a sentinel, not a time. The key is
                          // removed here rather than passed on, so that no date
                          // conversion downstream can turn "never launched"
                          // into 1970-01-01 and quietly corrupt every least
                          // recently played or date range query. A game that
                          // has never been launched therefore carries no
                          // steam.playtime.last_played field at all.
                          (int(g.?rtime_last_played.orValue(0)) != 0) ?
                            game
                          :
                            game.drop("rtime_last_played")
                        ).encode_json(),
                      }
                    )
                  )
                :
                  // An account with nothing to report still has to publish
                  // something, or want_more is ignored and the remaining
                  // accounts are never requested. Dropped by a processor below.
                  dyn([{"retry": true}]),
                // game_count is a property of the response rather than of a
                // game, so it is deliberately not emitted: it would repeat
                // identically on every document for the account, and is
                // recoverable by counting documents.
                "player_offset": (offset + 1 < size(state.steam_ids)) ? (offset + 1) : 0,
                "want_more": offset + 1 < size(state.steam_ids),
              }
            )
          :
            // The array error shape, not the single-object one. The only two
            // errors this endpoint produces are 403 for an invalid key and 400
            // for a malformed SteamID64, and neither is transient: the
            // single-object shape discards the returned state and re-runs from
            // the last good state, so it would retry both of them on every
            // evaluation forever and the player_offset reset below would never
            // be persisted. With the array shape the reset does persist, so a
            // failure part way through the walk sends the next poll back to
            // the top of the list rather than resuming mid-walk.
            {
              "events": [
                {
                  "error": {
                    "code": string(resp.StatusCode),
                    "id": string(resp.Status),
                    // Path only, never the query string: the API key travels
                    // as a query parameter and must not reach the logs.
                    "message": "GET /IPlayerService/GetOwnedGames/v1/: " + (
                      (size(resp.Body) != 0) ?
                        string(resp.Body)
                      :
                        string(resp.Status) + " (" + string(resp.StatusCode) + ")"
                    ),
                  },
                },
              ],
              "player_offset": 0,
              "want_more": false,
            }
        )
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- drop_event.when.equals.retry: true
{{#if processors}}
{{processors}}
{{/if}}
